# Development Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=chioma_dev
DB_PASSWORD=changeme
DB_NAME=chioma_dev

# JWT
JWT_SECRET=REDACTED_FOR_SECURITY
JWT_REFRESH_SECRET=REDACTED_FOR_SECURITY
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Stellar
NEXT_PUBLIC_STELLAR_NETWORK=
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_ADMIN_SECRET_KEY=
# Used to sign SEP-10-style wallet-login challenges (auth/stellar/challenge).
# Dev-only keypair, unfunded — the challenge flow never touches the network.
STELLAR_SERVER_SECRET_KEY=REDACTED_FOR_SECURITY

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Monitoring
LOG_LEVEL=debug
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_TTL=60000
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_STRICT_TTL=60000
RATE_LIMIT_STRICT_MAX=20

# Security - Encryption
SECURITY_ENCRYPTION_KEY=REDACTED_FOR_SECURITY

# NOTE: Secrets must not be stored in repository. Use secure secret management for real values.
